generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ========================================================
// ENUMS
// ========================================================

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum WorkerApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  CREATED
  SEARCHING
  ASSIGNED
  WORKER_ARRIVING
  ARRIVED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

// ========================================================
// USER & PROFILES
// ========================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  phone        String?    @unique
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customerProfile CustomerProfile?
  workerProfile   WorkerProfile?

  @@map("users")
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]

  @@map("customer_profiles")
}

model WorkerProfile {
  id              String               @id @default(uuid())
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String?
  avatarUrl       String?
  approvalStatus  WorkerApprovalStatus @default(DRAFT)
  idCardNumber    String?
  idCardVerified  Boolean              @default(false)
  skills          String[]
  bio             String?
  experienceYears Int?
  ratingAvg       Float                @default(0)
  totalReviews    Int                  @default(0)
  currentLat      Float?
  currentLng      Float?
  isOnline        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  workerServices WorkerService[]
  orders         Order[]
  faceProfile    FaceProfile?
  wallet         Wallet?
  reviews        Review[]

  @@map("worker_profiles")
}

model Address {
  id         String          @id @default(uuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String?
  street     String
  ward       String?
  district   String?
  city       String?
  latitude   Float
  longitude  Float
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  orders Order[]

  @@map("addresses")
}

// ========================================================
// SERVICE CATALOG & WORKER SERVICES
// ========================================================

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id                   String          @id @default(uuid())
  categoryId           String
  category             ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  basePrice            Decimal         @db.Decimal(12, 2)
  unit                 String?
  estimatedDurationMin Int?
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  workerServices WorkerService[]
  orders         Order[]

  @@map("services")
}

model WorkerService {
  id          String        @id @default(uuid())
  workerId    String
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customPrice Decimal?      @db.Decimal(12, 2)
  isAvailable Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workerId, serviceId])
  @@map("worker_services")
}

// ========================================================
// ORDER & WORKFLOW AGGREGATE
// ========================================================

model Order {
  id                 String          @id @default(uuid())
  customerId         String
  customer           CustomerProfile @relation(fields: [customerId], references: [id])
  workerId           String?
  worker             WorkerProfile?  @relation(fields: [workerId], references: [id])
  serviceId          String
  service            Service         @relation(fields: [serviceId], references: [id])
  addressId          String?
  address            Address?        @relation(fields: [addressId], references: [id])
  status             OrderStatus     @default(CREATED)
  pickupAddress      String?
  pickupLat          Float
  pickupLng          Float
  note               String?
  totalPrice         Decimal         @db.Decimal(12, 2)
  commissionRate     Float           @default(0.15)
  cancellationReason String?
  cancelledBy        String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  statusHistory      OrderStatusHistory[]
  images             OrderImage[]
  faceVerifications  FaceVerification[]
  aiAnalyses         AIAnalysis[]
  payment            Payment?
  commissionRecord   CommissionRecord?
  walletTransactions WalletTransaction[]
  review             Review?

  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  @@map("order_status_histories")
}

model OrderImage {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  imageUrl    String
  imageType   String
  description String?
  createdAt   DateTime @default(now())

  aiAnalyses AIAnalysis[]

  @@map("order_images")
}

// ========================================================
// AI & FACE VERIFICATION
// ========================================================

model FaceProfile {
  id            String        @id @default(uuid())
  workerId      String        @unique
  worker        WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  facePhotoUrl  String
  faceEmbedding Json?
  isRegistered  Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  verifications FaceVerification[]

  @@map("face_profiles")
}

model FaceVerification {
  id               String      @id @default(uuid())
  faceProfileId    String
  faceProfile      FaceProfile @relation(fields: [faceProfileId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?      @relation(fields: [orderId], references: [id])
  capturedPhotoUrl String
  similarityScore  Float
  isMatched        Boolean
  verifiedAt       DateTime    @default(now())

  @@map("face_verifications")
}

model AIAnalysis {
  id            String      @id @default(uuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderImageId  String?
  orderImage    OrderImage? @relation(fields: [orderImageId], references: [id])
  analysisType  String
  resultSummary String?
  rawResult     Json?
  confidence    Float?
  createdAt     DateTime    @default(now())

  @@map("ai_analyses")
}

// ========================================================
// PAYMENT, COMMISSION & WALLET
// ========================================================

model Payment {
  id              String    @id @default(uuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(12, 2)
  paymentMethod   String
  status          String    @default("PENDING")
  transactionCode String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  commissionRecord CommissionRecord?

  @@map("payments")
}

model CommissionRecord {
  id               String   @id @default(uuid())
  orderId          String   @unique
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String?  @unique
  payment          Payment? @relation(fields: [paymentId], references: [id])
  grossAmount      Decimal  @db.Decimal(12, 2)
  commissionRate   Float
  commissionAmount Decimal  @db.Decimal(12, 2)
  workerEarnings   Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  @@map("commission_records")
}

model Wallet {
  id        String        @id @default(uuid())
  workerId  String        @unique
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  balance   Decimal       @default(0) @db.Decimal(12, 2)
  currency  String        @default("VND")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String   @id @default(uuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  type          String
  description   String?
  balanceBefore Decimal  @db.Decimal(12, 2)
  balanceAfter  Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@map("wallet_transactions")
}

// ========================================================
// REVIEW
// ========================================================

model Review {
  id         String          @id @default(uuid())
  orderId    String          @unique
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  workerId   String
  worker     WorkerProfile   @relation(fields: [workerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("reviews")
}

// ========================================================
// SYSTEM SETTINGS
// ========================================================

model SystemSetting {
  id                    String   @id @default(uuid())
  siteName              String   @default("FixGo - Nền tảng Dịch vụ Cứu hộ & Sửa chữa")
  supportEmail          String   @default("support@fixgo.vn")
  supportHotline        String   @default("1900-8888")
  maxSearchRadiusKm     Float    @default(15.0)
  defaultCommissionRate Float    @default(15.0)
  orderTimeoutSeconds   Int      @default(60)
  autoMatching          Boolean  @default(true)
  notifyOnArrival       Boolean  @default(true)
  smsOtpEnabled         Boolean  @default(true)
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage    String?  @default("Hệ thống đang bảo trì nâng cấp định kỳ. Xin vui lòng quay lại sau ít phút!")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("system_settings")
}

